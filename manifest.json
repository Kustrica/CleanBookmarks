{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.2.5",
  "description": "__MSG_extensionDescription__",
  "author": "Kustrica (Telegram: @kustricadev)",
  "homepage_url": "https://t.me/kustricadev",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "contextMenus",
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Clean Bookmarks",
    "default_icon": "icons/CleanBookmark-200.png"
  },
  "icons": {
    "128": "icons/addon-128.png",
    "200": "icons/CleanBookmark-200.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "i18n.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "faviconbookmarks@kustrica.addon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
