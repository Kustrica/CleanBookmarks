{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0",
  "description": "__MSG_extensionDescription__",
  "author": "Kustrica (Telegram: @kustric)",
  "homepage_url": "https://t.me/kustric",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "contextMenus",
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Clean Bookmarks",
    "default_icon": "icons/CleanBookmark-200.png"
  },
  "icons": {
    "200": "icons/CleanBookmark-200.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "faviconbookmarks@kustrica.addon",
      "strict_min_version": "109.0",
            "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
